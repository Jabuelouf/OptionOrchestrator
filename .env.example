# Optional market-data providers. The application can run in mock mode without keys.
MARKET_DATA_PROVIDER=mock
MASSIVE_API_KEY=
MASSIVE_API_BASE=https://api.massive.com
MASSIVE_OPTIONS_ONLY=true
FINNHUB_API_KEY=
FINNHUB_API_BASE=https://finnhub.io
TWELVEDATA_API_KEY=
TWELVEDATA_API_BASE=https://api.twelvedata.com

# Optional hosted knowledge model. Deterministic fallbacks are used when unset.
RUNPOD_API_KEY=
KNOWLEDGE_ENDPOINT_ID=
HF_TOKEN=
HF_BASE_MODEL_ID=google/gemma-2-9b-it
HF_ADAPTER_ID=

# Optional broker import integration. Order execution is not implemented.
PUBLIC_COM_API_KEY=
PUBLIC_COM_API_SECRET=
PUBLIC_COM_BASE_URL=

# Optional persistence. SQLite is used locally when DATABASE_URL is unset.
DATABASE_URL=
PERSIST_RUNS=0
POSTGRES_USER=optionorch
POSTGRES_PASSWORD=optionorch
POSTGRES_DB=optionorch
POSTGRES_PORT=5432

HISTORY_CACHE_TTL_SECONDS=60
